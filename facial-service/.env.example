# Solo Python. Variables DB comunes y FACIAL_API_KEY están en ../.env.
# configure_local.py conserva las claves existentes; nunca versionar .env.
DB_DRIVER="ODBC Driver 18 for SQL Server"
FACIAL_ENCRYPTION_KEY=
# Punto de partida sin calibrar; confirmar con personas distintas y liveness real.
FACIAL_MATCH_THRESHOLD=0.50
FACIAL_LIVENESS_THRESHOLD=0.80
FACIAL_MODEL=buffalo_l
FACIAL_CAMERA_INDEX=0
FACIAL_CAMERA_BACKEND=AUTO
FACIAL_CAPTURE_TIMEOUT=120
