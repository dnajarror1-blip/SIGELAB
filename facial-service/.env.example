# Copiar manualmente a .env; nunca publicar el archivo privado.
DB_HOST=127.0.0.1
DB_PORT=1433
DB_NAME=SIGELAB
DB_USER=
DB_PASSWORD=
DB_DRIVER=ODBC Driver 18 for SQL Server
DB_ENCRYPT=true
DB_TRUST_SERVER_CERTIFICATE=false
# Base64 de 32 bytes aleatorios. Conservar la MISMA clave después del enrollment.
FACIAL_ENCRYPTION_KEY=
# Protección HTTP ya existente; compartir solo esta clave con Java, no la de cifrado.
FACIAL_API_KEY=
# Obligatorio: valor calibrado por el responsable facial, en (0,1]. Sin default.
FACIAL_MATCH_THRESHOLD=
FACIAL_LIVENESS_THRESHOLD=0.80
FACIAL_MODEL=buffalo_l
FACIAL_CAMERA_INDEX=0
# AUTO: V4L2 en Linux, DSHOW en Windows, AVFOUNDATION en macOS; fallback ANY.
FACIAL_CAMERA_BACKEND=AUTO
FACIAL_CAPTURE_TIMEOUT=120
